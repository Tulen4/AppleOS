#!/bin/bash
# AppleOS live-setup: prepares the live session before SDDM starts.
# Run by the appleos-live.service unit (oneshot, Before=sddm).
set -u

# 1. liveuser home from skel (sysusers created the user, tmpfiles — the dir)
if [ ! -f /home/liveuser/.bashrc ] && [ -d /etc/skel ]; then
  cp -a /etc/skel/. /home/liveuser/
fi
chown -R 1000:1000 /home/liveuser 2>/dev/null || true

# 2. Autologin session: first available (labwc = Apple Shell, the default)
SESSION=""
for d in /usr/share/wayland-sessions /usr/share/xsessions; do
  for cand in labwc.desktop cosmic.desktop plasma.desktop gnome.desktop xfce.desktop hyprland.desktop sway.desktop i3.desktop; do
    if [ -f "$d/$cand" ]; then SESSION="$cand"; break 2; fi
  done
done
if [ -n "$SESSION" ]; then
  mkdir -p /etc/sddm.conf.d
  sed -i "s/^Session=.*/Session=$SESSION/" /etc/sddm.conf.d/appleos-autologin.conf 2>/dev/null || true
fi

# 3. Network: NetworkManager is already enabled, just wake Wi-Fi up
nmcli radio wifi on 2>/dev/null || true
