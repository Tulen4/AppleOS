#!/bin/bash
# Apple Shell Settings — GUI tweaks for the AppleOS desktop:
# wallpaper, dark/light theme, dock icon size, keybindings cheat sheet.
# English/Russian (auto from $LANG). Zenity required.
set -u

ICON="/usr/share/pixmaps/appleos-logo.png"
CFG="$HOME/.config"
SHARE="/usr/share/apple-shell"

case "${LANG:-en}" in ru*) L=ru;; *) L=en;; esac

if [ "$L" = ru ]; then
  T_TITLE="Настройки Apple Shell"
  T_MAIN="Что настроить?"
  T_WALL="Обои…"; T_THEME="Тёмная / светлая тема"; T_DOCK="Размер иконок дока"
  T_KEYS="Горячие клавиши"; T_ABOUT="Об Apple Shell"
  T_DARK="Тёмная"; T_LIGHT="Светлая"
  T_THEME_NOTE="Тема GTK применится для новых окон. Панели переключаются сразу."
  T_DOCK_S="Мелкие"; T_DOCK_M="Средние"; T_DOCK_L="Крупные"
  T_ABOUT_TEXT="Apple Shell — оригинальный рабочий стол AppleOS на labwc.\nВерхняя меню-панель, нижний док, Spotlight (Super+Space).\nНикаких ассетов Apple: все иконки и обои нарисованы проектом."
  T_KEYS_TEXT="Super+Space — Spotlight   Super+D — меню приложений\nSuper+T / Super+Enter — терминал   Super+W — браузер\nSuper+E — файлы   Super+I / Super+, — эти настройки\nSuper+Q — закрыть   Super+M / Super+Down — свернуть\nSuper+F — во весь экран   Super+Shift+F — развернуть\nSuper+Left/Right — половины экрана   Super+1..4 — столы\nCtrl+Left/Right — соседний стол   Super+Tab — окна\nSuper+Shift+D — показать стол   Super+L — заблокировать\nSuper+Shift+3/4 — скриншот"
  T_WALL_TITLE="Выбери обои"
  T_DONE="Применено"
else
  T_TITLE="Apple Shell Settings"
  T_MAIN="What to tweak?"
  T_WALL="Wallpaper…"; T_THEME="Dark / light theme"; T_DOCK="Dock icon size"
  T_KEYS="Keybindings"; T_ABOUT="About Apple Shell"
  T_DARK="Dark"; T_LIGHT="Light"
  T_THEME_NOTE="GTK theme applies to new windows. Bars switch instantly."
  T_DOCK_S="Small"; T_DOCK_M="Medium"; T_DOCK_L="Large"
  T_ABOUT_TEXT="Apple Shell — the original AppleOS desktop on labwc.\nTop menu bar, bottom dock, Spotlight (Super+Space).\nNo Apple assets: all artwork is drawn by the project."
  T_KEYS_TEXT="Super+Space — Spotlight   Super+D — app menu\nSuper+T / Super+Enter — terminal   Super+W — browser\nSuper+E — files   Super+I / Super+, — these settings\nSuper+Q — close   Super+M / Super+Down — minimize\nSuper+F — fullscreen   Super+Shift+F — maximize\nSuper+Left/Right — screen halves   Super+1..4 — workspaces\nCtrl+Left/Right — neighbor workspace   Super+Tab — windows\nSuper+Shift+D — show desktop   Super+L — lock\nSuper+Shift+3/4 — screenshot"
  T_WALL_TITLE="Pick a wallpaper"
  T_DONE="Applied"
fi

pick_wallpaper() {
  W="$(zenity --file-selection --window-icon="$ICON" --title="$T_WALL_TITLE" \
    --file-filter="Images | *.png *.jpg *.jpeg *.webp" 2>/dev/null)" || return 0
  [ -f "$W" ] || return 0
  mkdir -p "$CFG/apple-shell"
  echo "$W" > "$CFG/apple-shell/wallpaper"
  pkill swaybg 2>/dev/null
  swaybg -i "$W" -m fill &
  zenity --info --window-icon="$ICON" --text="$T_DONE" 2>/dev/null
}

pick_theme() {
  M="$(zenity --list --radiolist --window-icon="$ICON" --print-column=2 \
    --title="$T_THEME" --text="$T_THEME_NOTE" \
    --column="" --column="x" TRUE "$T_DARK" FALSE "$T_LIGHT" 2>/dev/null)" || return 0
  mkdir -p "$CFG/labwc" "$CFG/waybar"
  if [ "$M" = "$T_LIGHT" ]; then
    GTK="WhiteSur-Light"; [ -d /usr/share/themes/WhiteSur-Light ] || GTK="Adwaita"
    cp "$CFG/waybar/style-top-light.css" "$CFG/waybar/style.css" 2>/dev/null || cp "$SHARE/waybar/style-top-light.css" "$CFG/waybar/style.css"
    cp "$CFG/waybar/style-dock-light.css" "$CFG/waybar/style-dock.css" 2>/dev/null || cp "$SHARE/waybar/style-dock-light.css" "$CFG/waybar/style-dock.css"
  else
    GTK="WhiteSur-Dark"; [ -d /usr/share/themes/WhiteSur-Dark ] || GTK="Adwaita-dark"
    cp "$CFG/waybar/style-top-dark.css" "$CFG/waybar/style.css" 2>/dev/null || cp "$SHARE/waybar/style-top-dark.css" "$CFG/waybar/style.css"
    cp "$CFG/waybar/style-dock-dark.css" "$CFG/waybar/style-dock.css" 2>/dev/null || cp "$SHARE/waybar/style-dock-dark.css" "$CFG/waybar/style-dock.css"
  fi
  sed -i "s/^GTK_THEME=.*/GTK_THEME=$GTK/" "$CFG/labwc/environment" 2>/dev/null \
    || echo "GTK_THEME=$GTK" >> "$CFG/labwc/environment"
  pkill -SIGUSR2 waybar 2>/dev/null
  zenity --info --window-icon="$ICON" --text="$T_DONE" 2>/dev/null
}

pick_dock() {
  S="$(zenity --list --radiolist --window-icon="$ICON" --print-column=2 \
    --title="$T_DOCK" --text="$T_DOCK" \
    --column="" --column="x" FALSE "$T_DOCK_S" TRUE "$T_DOCK_M" FALSE "$T_DOCK_L" 2>/dev/null)" || return 0
  case "$S" in
    "$T_DOCK_S") SZ=24 ;;
    "$T_DOCK_L") SZ=36 ;;
    *) SZ=30 ;;
  esac
  sed -i "s/\"icon-size\": [0-9]*/\"icon-size\": $SZ/" "$CFG/waybar/config-dock.json" 2>/dev/null
  pkill -SIGUSR2 waybar 2>/dev/null
  zenity --info --window-icon="$ICON" --text="$T_DONE" 2>/dev/null
}

while true; do
  ACT="$(zenity --list --radiolist --window-icon="$ICON" --print-column=2 \
    --title="$T_TITLE" --text="$T_MAIN" \
    --column="" --column="x" \
    TRUE "$T_WALL" FALSE "$T_THEME" FALSE "$T_DOCK" FALSE "$T_KEYS" FALSE "$T_ABOUT" 2>/dev/null)" || exit 0
  case "$ACT" in
    "$T_WALL") pick_wallpaper ;;
    "$T_THEME") pick_theme ;;
    "$T_DOCK") pick_dock ;;
    "$T_KEYS") zenity --info --window-icon="$ICON" --title="$T_KEYS" --text="$T_KEYS_TEXT" --width=520 2>/dev/null ;;
    *) zenity --info --window-icon="$ICON" --title="$T_ABOUT" --text="$T_ABOUT_TEXT" --width=480 2>/dev/null ;;
  esac
done
