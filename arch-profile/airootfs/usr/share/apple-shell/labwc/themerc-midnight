# Apple Shell :: labwc window decoration override (midnight / OLED black).
border.width: 1
window.active.border.color: #2a2a30
window.inactive.border.color: #1a1a20
window.active.title.bg.color: #000000
window.inactive.title.bg.color: #000000
window.*.title.bg: Solid
window.active.label.text.color: #e8e8e8
window.inactive.label.text.color: #777777
window.label.text.justify: center
window.button.width: 26
window.button.height: 26
window.active.button.unpressed.image.color: #bbbbbb
window.inactive.button.unpressed.image.color: #555555
window.button.hover.bg.color: #ffffff20
window.active.shadow.size: 40
window.active.shadow.color: #00000080
window.inactive.shadow.size: 24
window.inactive.shadow.color: #00000060
menu.border.width: 1
menu.border.color: #2a2a30
menu.items.bg.color: #000000
menu.items.text.color: #e8e8e8
menu.items.active.bg.color: #0a84ff
menu.items.active.text.color: #ffffff
menu.items.padding.x: 8
menu.items.padding.y: 5
menu.separator.width: 1
menu.separator.color: #2a2a30
menu.title.bg.color: #000000
menu.title.text.color: #ffffff
osd.bg.color: #000000
osd.border.color: #2a2a30
osd.border.width: 1
osd.label.text.color: #ffffff
osd.window-switcher.style-classic.item.active.bg.color: #0a84ff
osd.window-switcher.style-classic.item.active.text.color: #ffffff
