# Apple Shell :: labwc window decoration override (light).
border.width: 1
window.active.border.color: #c8c8d0
window.inactive.border.color: #d8d8de
window.active.title.bg.color: #ececf0
window.inactive.title.bg.color: #f4f4f6
window.*.title.bg: Solid
window.active.label.text.color: #1a1a1e
window.inactive.label.text.color: #777777
window.label.text.justify: center
window.button.width: 26
window.button.height: 26
window.active.button.unpressed.image.color: #555555
window.inactive.button.unpressed.image.color: #999999
window.button.hover.bg.color: #00000020
window.active.shadow.size: 50
window.active.shadow.color: #00000040
window.inactive.shadow.size: 30
window.inactive.shadow.color: #00000030
menu.border.width: 1
menu.border.color: #c8c8d0
menu.items.bg.color: #f2f2f6
menu.items.text.color: #1a1a1e
menu.items.active.bg.color: #0a84ff
menu.items.active.text.color: #ffffff
menu.items.padding.x: 8
menu.items.padding.y: 5
menu.separator.width: 1
menu.separator.color: #c8c8d0
menu.title.bg.color: #f2f2f6
menu.title.text.color: #1a1a1e
osd.bg.color: #f2f2f6
osd.border.color: #c8c8d0
osd.border.width: 1
osd.label.text.color: #1a1a1e
osd.window-switcher.style-classic.item.active.bg.color: #0a84ff
osd.window-switcher.style-classic.item.active.text.color: #ffffff
