#!/bin/bash
# AppleOS finish — the last install step, in the target chroot.
# Cleans live artifacts, enables services, sets the shell, fixes the repo, calls drivers.
set -u
LOG=/root/appleos-install.log
exec >>"$LOG" 2>&1
echo "=== appleos-finish: $(date -u) ==="

# 1. Remove live artifacts (installer autostart + shortcuts, live autologin, live net masks)
rm -f /etc/xdg/autostart/appleos-installer.desktop
rm -f /usr/share/applications/appleos-install-online.desktop /usr/share/applications/appleos-install-offline.desktop
rm -f /etc/sddm.conf.d/appleos-autologin.conf
rm -f /etc/systemd/system/systemd-networkd.service /etc/systemd/system/iwd.service
rm -f /etc/sudoers.d/10-liveuser
rm -f /usr/local/bin/appleos-live /usr/local/bin/appleos-wifi /usr/local/bin/appleos-installer-chooser
rm -f /usr/lib/sysusers.d/appleos-live.conf /usr/lib/tmpfiles.d/appleos-live.conf
rm -f /etc/systemd/system/appleos-live.service \
      /etc/systemd/system/multi-user.target.wants/appleos-live.service

# 2. Target services: NetworkManager networking, graphical login, early OOM guard
# (zram needs no enable: the generator picks up its config automatically)
systemctl enable NetworkManager sddm earlyoom 2>/dev/null || true
systemctl set-default graphical.target 2>/dev/null || true

# 3. Real users (uid>=1000, except liveuser)
USERS="$(awk -F: '$3>=1000 && $1!="nobody" && $1!="liveuser" {print $1}' /etc/passwd)"

# 4. User shell: zsh > fish > bash — matching the netinstall choice
NEWSHELL=/bin/bash
command -v zsh  >/dev/null && NEWSHELL=/bin/zsh
command -v fish >/dev/null && [ "$NEWSHELL" = /bin/bash ] && NEWSHELL=/bin/fish
for u in $USERS; do
  [ -x "$NEWSHELL" ] && chsh -s "$NEWSHELL" "$u" && echo "shell($u)=$NEWSHELL"
done

# 5. Drop liveuser if a real user was created
if [ -n "$USERS" ] && id liveuser >/dev/null 2>&1; then
  userdel -r liveuser 2>/dev/null || userdel liveuser 2>/dev/null || true
  echo "liveuser removed"
fi

# 6. Drivers (EndeavourOS-style)
if [ -x /usr/local/bin/appleos-drivers ]; then
  /usr/local/bin/appleos-drivers || echo "WARN: appleos-drivers failed, see /root/appleos-drivers.log"
fi

# 7. EndeavourOS repo on the target — re-enable signature checks.
# Build-time ISO used SigLevel Never (otherwise pacstrap can't see the key),
# the endeavouros-keyring key is already installed as a package — trust it.
if grep -q "^\[endeavouros\]" /etc/pacman.conf 2>/dev/null && pacman -Q endeavouros-keyring >/dev/null 2>&1; then
  awk 'BEGIN{repo=0} /^\[endeavouros\]/{repo=1} /^\[/&&!/^\[endeavouros\]/{repo=0} repo&&/^SigLevel/{print "SigLevel = PackageRequired"; next} {print}' \
    /etc/pacman.conf > /etc/pacman.conf.new && mv /etc/pacman.conf.new /etc/pacman.conf
  echo "endeavouros repo hardened (PackageRequired)"
fi

# 8. Drop the local build repo (its file:// build path is dead on the target).
if grep -q "^\[appleos-local\]" /etc/pacman.conf 2>/dev/null; then
  awk 'BEGIN{skip=0} /^\[appleos-local\]/{skip=1; next} /^\[/{skip=0} !skip' \
    /etc/pacman.conf > /etc/pacman.conf.new && mv /etc/pacman.conf.new /etc/pacman.conf
  echo "appleos-local repo removed from target"
fi

# 9. GRUB branding: AppleOS theme + distributor, splash for plymouth.
if [ -f /usr/share/grub/themes/appleos/theme.txt ]; then
  if grep -q '^GRUB_THEME=' /etc/default/grub 2>/dev/null; then
    sed -i 's|^GRUB_THEME=.*|GRUB_THEME="/usr/share/grub/themes/appleos/theme.txt"|' /etc/default/grub
  else
    echo 'GRUB_THEME="/usr/share/grub/themes/appleos/theme.txt"' >> /etc/default/grub
  fi
  grep -q '^GRUB_GFXMODE=' /etc/default/grub 2>/dev/null \
    || echo 'GRUB_GFXMODE=1920x1080,auto' >> /etc/default/grub
  if grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub 2>/dev/null; then
    sed -i 's|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR="AppleOS"|' /etc/default/grub
  else
    echo 'GRUB_DISTRIBUTOR="AppleOS"' >> /etc/default/grub
  fi
  if grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' /etc/default/grub 2>/dev/null; then
    grep -q 'splash' /etc/default/grub \
      || sed -i 's|^GRUB_CMDLINE_LINUX_DEFAULT="\([^"]*\)"|GRUB_CMDLINE_LINUX_DEFAULT="\1 splash"|' /etc/default/grub
  else
    echo 'GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet splash"' >> /etc/default/grub
  fi
  grub-mkconfig -o /boot/grub/grub.cfg >>"$LOG" 2>&1 || echo "WARN: grub-mkconfig failed"
  echo "grub branded (theme, distributor, splash)"
fi

# 10. Plymouth in the target initramfs (splash at every boot).
if [ -f /etc/mkinitcpio.conf ] && ! grep -qE 'HOOKS=.*plymouth' /etc/mkinitcpio.conf; then
  if grep -qE 'HOOKS=\([^)]*\bkms\b' /etc/mkinitcpio.conf; then
    sed -i -E 's/(HOOKS=\([^)]*\bkms\b)/\1 plymouth/' /etc/mkinitcpio.conf
  else
    sed -i -E 's/(HOOKS=\([^)]*\budev\b)/\1 plymouth/' /etc/mkinitcpio.conf
  fi
  mkinitcpio -P >>"$LOG" 2>&1 || echo "WARN: mkinitcpio failed"
  echo "plymouth hook enabled"
fi

# 11. Apple Shell theming (only if labwc was chosen in the installer).
# No other offered desktop pulls labwc, so its presence == user choice.
# GTK default is Adwaita-dark (always present); WhiteSur is best-effort via
# yay as nobody (yay refuses root), then applied to skel + created users.
if pacman -Q labwc >/dev/null 2>&1; then
  echo "apple-shell selected, theming"
  GTK="Adwaita-dark"
  if timeout 15 pacman -Sy >/dev/null 2>&1 && command -v yay >/dev/null 2>&1 && id nobody >/dev/null 2>&1; then
    mkdir -p /tmp/yay-aur && chmod 777 /tmp/yay-aur
    if HOME=/tmp/yay-aur sudo -u nobody yay -S --needed --noconfirm whitesur-gtk-theme whitesur-icon-theme >>"$LOG" 2>&1 \
       && [ -d /usr/share/themes/WhiteSur-Dark ]; then
      GTK="WhiteSur-Dark"
    else
      echo "WARN: WhiteSur failed, keeping Adwaita-dark"
    fi
    rm -rf /tmp/yay-aur
  else
    echo "WARN: no network/yay/nobody for WhiteSur, keeping Adwaita-dark"
  fi
  sed -i "s/^GTK_THEME=.*/GTK_THEME=$GTK/" /etc/skel/.config/labwc/environment
  for u in $USERS; do
    H="$(eval echo "~$u")"
    [ -f "$H/.config/labwc/environment" ] \
      && sed -i "s/^GTK_THEME=.*/GTK_THEME=$GTK/" "$H/.config/labwc/environment"
  done
  echo "gtk theme: $GTK"
fi

echo "=== appleos-finish done ==="
