[Desktop Entry]
Type=Application
Name=Install AppleOS (offline)
Name[ru]=Установить AppleOS (офлайн)
Comment=Offline install: ready live system (COSMIC), no internet needed
Comment[ru]=Установка без интернета: готовая live-система (COSMIC)
Exec=sudo -E calamares -c /etc/calamares/settings_offline.conf
Icon=/usr/share/pixmaps/appleos-logo.png
Terminal=false
Categories=System;Settings;
