#!/bin/bash
# AppleOS installer launcher: checks network, offers Wi-Fi setup if offline,
# then starts the (online) Calamares installer. English/Russian (auto from $LANG).
set -u

ICON="/usr/share/pixmaps/appleos-logo.png"

has_net() {
  curl -sI --max-time 6 https://archlinux.org >/dev/null 2>&1 && return 0
  ping -c1 -W3 1.1.1.1 >/dev/null 2>&1
}

case "${LANG:-en}" in ru*) L=ru;; *) L=en;; esac

if [ "$L" = ru ]; then
  T_NONET="Нет интернета — установщику нужен интернет (пакеты докачиваются из сети)."
  T_WIFI="Настроить Wi-Fi"; T_INSTALL="Установить всё равно"; T_CLOSE="Выйти"
  T_W_TITLE="AppleOS — Wi-Fi"; T_W_PICK="Выбери сеть:"; T_W_NET="Сеть"
  T_W_NONE="Сети не найдены. Проверь адаптер: nmcli dev"
  T_W_PASS="Пароль для «%s» (пусто — открытая сеть):"
  T_W_OK="Подключено к «%s»"; T_W_IP=" (IP: %s)"; T_W_FAIL="Не подключилось:\n%s"
else
  T_NONET="No internet — the installer needs it (packages download from repos)."
  T_WIFI="Set up Wi-Fi"; T_INSTALL="Install anyway"; T_CLOSE="Quit"
  T_W_TITLE="AppleOS — Wi-Fi"; T_W_PICK="Pick a network:"; T_W_NET="Network"
  T_W_NONE="No networks found. Check the adapter: nmcli dev"
  T_W_PASS="Password for “%s” (empty — open network):"
  T_W_OK="Connected to “%s”"; T_W_IP=" (IP: %s)"; T_W_FAIL="Connection failed:\n%s"
fi

wifi_setup() {
  nmcli radio wifi on 2>/dev/null
  nmcli dev wifi rescan >/dev/null 2>&1
  sleep 2
  NETS="$(nmcli -t -f SSID,SIGNAL dev wifi list --rescan no 2>/dev/null | grep -v '^--' | awk -F: '!seen[$1]++ && $1!=""' | head -30)"
  [ -n "$NETS" ] || { zenity --error --window-icon="$ICON" --text="$T_W_NONE" 2>/dev/null; return 1; }
  CHOICE="$(echo "$NETS" | awk -F: '{print $1" ("$2"%)"}' | zenity --list --window-icon="$ICON" \
    --title="$T_W_TITLE" --text="$T_W_PICK" --column="$T_W_NET" 2>/dev/null)" || return 1
  SSID="${CHOICE% (*}"
  [ -n "$SSID" ] || return 1
  # shellcheck disable=SC2059
  PROMPT="$(printf "$T_W_PASS" "$SSID")"
  PASS="$(zenity --entry --hide-text --window-icon="$ICON" --title="$T_W_TITLE" \
    --text="$PROMPT" 2>/dev/null)" || return 1
  if [ -z "$PASS" ]; then
    OUT="$(nmcli dev wifi connect "$SSID" 2>&1)"
  else
    OUT="$(nmcli dev wifi connect "$SSID" password "$PASS" 2>&1)"
  fi
  if [ $? -eq 0 ]; then
    IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
    # shellcheck disable=SC2059
    MSG="$(printf "$T_W_OK" "$SSID")"; [ -n "$IP" ] && MSG="$MSG$(printf "$T_W_IP" "$IP")"
    zenity --info --window-icon="$ICON" --text="$MSG" 2>/dev/null
  else
    # shellcheck disable=SC2059
    zenity --error --window-icon="$ICON" --text="$(printf "$T_W_FAIL" "$OUT")" 2>/dev/null
    return 1
  fi
}

if ! command -v zenity >/dev/null 2>&1; then
  exec sudo -E calamares
fi

while true; do
  has_net && exec sudo -E calamares
  ACT="$(zenity --list --radiolist --window-icon="$ICON" --print-column=2 \
    --title="AppleOS" --text="$T_NONET" \
    --column="" --column="x" \
    TRUE "$T_WIFI" FALSE "$T_INSTALL" FALSE "$T_CLOSE" 2>/dev/null)" || exit 0
  case "$ACT" in
    "$T_WIFI") wifi_setup ;;
    "$T_INSTALL") exec sudo -E calamares ;;
    *) exit 0 ;;
  esac
done
