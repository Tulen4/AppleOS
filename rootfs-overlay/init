#!/bin/sh
# AppleOS /init — PID 1. Minimal shell init.
# The kernel mounts initramfs as root and runs this file.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=linux

mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null
mkdir -p /dev/pts 2>/dev/null
mount -t devpts none /dev/pts 2>/dev/null

hostname appleos 2>/dev/null

clear 2>/dev/null
cat /etc/motd 2>/dev/null
echo ""
echo "  uname : $(uname -srm 2>/dev/null)"
echo "  shells: $(ls /bin/sh 2>/dev/null)"
echo ""
echo "Welcome to AppleOS! Reboot: exec reboot / power off: exec poweroff"
echo ""

# Install all busybox applets (in case some links missed the image)
busybox --install -s /bin 2>/dev/null

# Interactive shell as PID 1. Ctrl-C won't kill init, that's fine.
exec /bin/sh -l
